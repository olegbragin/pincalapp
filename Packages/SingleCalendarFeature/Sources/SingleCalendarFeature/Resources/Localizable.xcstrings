          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Содержимое"
          }
        }
      }
    },
    "Event time" : {
      "comment" : "The row in the batch editor that opens the hour and minute wheels. Just a name for the attribute, not an instruction — the old 'Select event time' read as a command on a control that is a button opening something else.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event time"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время события"
          }
        }
      }
    },
