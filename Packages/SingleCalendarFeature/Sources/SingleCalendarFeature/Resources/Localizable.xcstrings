    "Deselect" : {
      "comment" : "Removes an event from the batch editor's selection, leaving it in the batch. Paired with \"Delete event\", which removes it from the batch entirely.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deselect"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снять выбор"
          }
        }
      }
    },
    "Deselect all" : {
      "comment" : "Clears the whole selection at once, since the selection's only other exit is one row at a time.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deselect all"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снять выбор со всех"
          }
        }
