{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ at %@" : {
      "comment" : "Formerly keyed 'eventAt'",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ at %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ в %2$@"
          }
        }
      }
    },
    "Back" : {
      "comment" : "The back affordance in the event and batch editors. It was never in any catalog, so it rendered as plain English on every device until per-package extraction surfaced it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назад"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "The label of a button that cancels a time change. Throws away the event-time wheel's draft without applying it; paired with Done in the same popover.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмена"
          }
        }
      }
    },
    "Close" : {
      "comment" : "The exit from the batch editor, which is the root of a sheet. Added with the xmark that replaced the back chevron there — the editor no longer goes 'back' anywhere.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрыть"
          }
        }
      }
    },
    "Content" : {
      "comment" : "",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
